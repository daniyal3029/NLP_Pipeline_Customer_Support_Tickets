cell_type":"code","source":"glove = {}\nglove_path = \"/kaggle/input/datasets/rtatman/glove-global-vectors-for-word-representation/glove.6B.200d.txt\"\n\nwith open(glove_path, \"r\", encoding=\"utf8\") as f:\n    for line in f:\n        parts  = line.split()\n        word   = parts[0]\n        vector = np.array(parts[1:], dtype=np.float32)\n        glove[word] = vector\n\nEMBED_DIM = 200\nprint(\"Total GloVe words:\", len(glove))\nprint(\"Vector size:\", len(glove[\"computer\"]))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T23:08:07.292377Z","iopub.execute_input":"2026-03-15T23:08:07.292677Z","iopub.status.idle":"2026-03-15T23:08:22.969871Z","shell.execute_reply.started":"2026-03-15T23:08:07.292646Z","shell.execute_reply":"2026-03-15T23:08:22.969258Z"}},"outputs":[{"name":"stdout","text":"Total GloVe words: 400000\nVector size: 200\n","output_type":"stream"}],"execution_count":298},{"cell_type":"markdown","source":"### 3b. Load GloVe Weights into torch.nn.Embedding","metadata":{}},{"cell_type":"code","source":"# Build embedding matrix aligned with our vocabulary\n# OOV tokens -> zero vector (UNK strategy)\nunk_vector = np.zeros(EMBED_DIM, dtype=np.float32)\n\nembedding_matrix = np.zeros((vocab_size, EMBED_DIM), dtype=np.float32)\noov_count = 0\n\nfor w, idx in word2idx.items():\n    vec = glove.get(w, None)\n    if vec is not None:\n        embedding_matrix[idx] = vec\n    else:\n        oov_count += 1\n        embedding_matrix[idx] = unk_vector\n\nprint(f\"OOV tokens: {oov_count} / {vocab_size} ({100*oov_count/vocab_size:.1f}%)\")\n\n# Load into torch.nn.Embedding with frozen pretrained weights\nembedding_layer = torch.nn.Embedding(vocab_size, EMBED_DIM)\nembedding_layer.weight = torch.nn.Parameter(\n    torch.tensor(embedding_matrix, dtype=torch.float32),\n    requires_grad=False\n)\nembedding_layer = embedding_layer.to(device)\nprint(\"Embedding layer:\", embedding_layer)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T23:08:22.970819Z","iopub.execute_input":"2026-03-15T23:08:22.971134Z","iopub.status.idle":"2026-03-15T23:08:22.993125Z","shell.execute_reply.started":"2026-03-15T23:08:22.971110Z","shell.execute_reply":"2026-03-15T23:08:22.992376Z"}},"outputs":[{"name":"stdout","text":"OOV tokens: 389 / 5000 (7.8%)\nEmbedding layer: Embedding(5000, 200)\n","output_type":"stream"}],"execution_count":299},{"cell_type":"markdown","source":"### 3c. TF-IDF Weighted Sentence Embedding (prevents semantic dilution)","metadata":{}},{"cell_type":"code","source":"def sentence_embedding(tokens, tfidf_vec):\n    \"\"\"\n    TF-IDF weighted average of GloVe vectors.\n    Rare technical words get higher weight than common words,\n    preventing semantic dilution. OOV tokens -> zero vector.\n    \"\"\"\n    sent_vec     = np.zeros(EMBED_DIM)\n    total_weight = 0.0\n    for w in tokens:\n        if w in word2idx:\n            weight       = tfidf_vec[word2idx[w]]\n            word_vec     = glove.get(w, unk_vector)\n            sent_vec    += weight * word_vec\n            total_weight += weight\n    if total_weight > 0:\n        sent_vec /= total_weight\n    return sent_vec\n\ndf[\"semantic_vec\"] = df.apply(\n    lambda row: sentence_embedding(row[\"tokens\"], row[\"tfidf\"]), axis=1)\n\nprint(\"Semantic vector length:\", len(df[\"semantic_vec\"][0]))\ndf[\"semantic_vec\"].iloc[0][:10]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T23:08:22.994089Z","iopub.execute_input":"2026-03-15T23:08:22.994319Z","iopub.status.idle":"2026-03-15T23:08:23.778667Z","shell.execute_reply.started":"2026-03-15T23:08:22.994299Z","shell.execute_reply":"2026-03-15T23:08:23.777941Z"}},"outputs":[{"name":"stdout","text":"Semantic vector length: 200\n","output_type":"stream"},{"execution_count":300,"output_type":"execute_result","data":{"text/plain":"array([ 0.26550896,  0.25889506,  0.33168345, -0.08756673,  0.14945391,\n       -0.09377598, -0.51290619, -0.04446621, -0.02457142,  0.11429735])"},"metadata":{}}],"execution_count":300},{"cell_type":"code","source":"semantic_matrix = np.vstack(df[\"semantic_vec\"].values)\nsemantic_tensor = torch.tensor(semantic_matrix, dtype=torch.float32).to(device)\nprint(\"Semantic tensor shape:\", semantic_tensor.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T23:08:23.779643Z","iopub.execute_input":"2026-03-15T23:08:23.779920Z","iopub.status.idle":"2026-03-15T23:08:23.796605Z","shell.execute_reply.started":"2026-03-15T23:08:23.779897Z","shell.execute_reply":"2026-03-15T23:08:23.795924Z"}},"outputs":[{"name":"stdout","text":"Semantic tensor shape: torch.Size([8469, 200])\n","output_type":"stream"}],"execution_count":301},{"cell_type":"markdown","source":"## Implementation Tasks","metadata":{}},{"cell_type":"markdown","source":"### Task 1 & 2: Hybrid Search Pipeline\n`FinalScore = α·(TF-IDF Score) + (1−α)·(GloVe Score)`  — α = 0.4","metadata":{}},{"cell_type":"code","source":"import torch.nn.functional as F\n\ndef query_embedding(query):\n    \"\"\"Convert raw query string to GloVe sentence embedding.\"\"\"\n    q      = clean_text(query)\n    tokens = tokenize(q)\n    tv     = compute_tfidf(tokens)\n    return sentence_embedding(tokens, tv)\n\ndef query_tfidf_vector(query):\n    \"\"\"Convert raw query string to TF-IDF vector.\"\"\"\n    q      = clean_text(query)\n    tokens = tokenize(q)\n    return compute_tfidf(tokens)\n\ndef semantic_search(query_vec, sem_tensor):\n    \"\"\"Cosine similarity using GloVe embeddings on GPU.\"\"\"\n    q = torch.tensor(query_vec, dtype=torch.float32).to(device)\n    return F.cosine_similarity(q.unsqueeze(0), sem_tensor)\n\ndef tfidf_search(query_tfidf_vec):\n    \"\"\"Cosine similarity using TF-IDF on GPU.\"\"\"\n    q = torch.tensor(query_tfidf_vec, dtype=torch.float32).to(device)\n    return F.cosine_similarity(q.unsqueeze(0), tfidf_tensor)\n\ndef hybrid_search(query, alpha=0.4):\n    \"\"\"\n    FinalScore = alpha * TF-IDF_Score + (1 - alpha) * GloVe_Score\n    alpha = 0.4 as specified in assignment.\n    \"\"\"\n    sem_scores   = semantic_search(query_embedding(query), semantic_tensor)\n    tfidf_scores = tfidf_search(query_tfidf_vector(query))\n    return alpha * tfidf_scores + (1 - alpha) * sem_scores\n\nprint(\"Search functions defined\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T23:08:23.797556Z","iopub.execute_input":"2026-03-15T23:08:23.798087Z","iopub.status.idle":"2026-03-15T23:08:23.811332Z","shell.execute_reply.started":"2026-03-15T23:08:23.798060Z","shell.execute_reply":"2026-03-15T23:08:23.810651Z"}},"outputs":[{"name":"stdout","text":"Search functions defined\n","output_type":"stream"}],"execution_count":302},{"cell_type":"code","source":"def display_results(query, top_indices, top_scores, label=\"Hybrid\"):\n    \"\"\"Pretty-print retrieval results.\"\"\"\n    print(f\"Top 5 {label} results for query: '{query}'\")\n    print(\"=\" * 60)\n    for rank, (idx, score) in enumerate(\n            zip(top_indices.cpu().numpy(), top_scores.cpu().numpy()), 1):\n        row = df.iloc[idx]\n        print(f\"Rank {rank}  |  Score: {score:.4f}  |  Type: {row['Ticket Type']}\")\n        print(f\"  Subject    : {row['display_subject']}\")\n        print(f\"  Description: {row['display_description']}\")\n        print()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T23:08:23.814761Z","iopub.execute_input":"2026-03-15T23:08:23.815003Z","iopub.status.idle":"2026-03-15T23:08:23.826718Z","shell.execute_reply.started":"2026-03-15T23:08:23.814976Z","shell.execute_reply":"2026-03-15T23:08:23.826184Z"}},"outputs":[],"execution_count":303},{"cell_type":"markdown","source":"### Semantic-Only Search Test","metadata":{}},{"cell_type":"code","source":"query      = \"payment failed\"\nsem_scores = semantic_search(query_embedding(query), semantic_tensor)\ntop5       = torch.topk(sem_scores, 5)\ndisplay_results(query, top5.indices, top5.values, label=\"Semantic (